{
  "name": "cyboflow-download-counter",
  "version": "0.1.0",
  "private": true,
  "description": "Counts Cyboflow installer downloads, then redirects to the R2 release host",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "schema": "wrangler d1 execute cyboflow-downloads --remote --file=./schema.sql",
    "schema:local": "wrangler d1 execute cyboflow-downloads --local --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260701.0",
    "wrangler": "^4.116.0"
  }
}
